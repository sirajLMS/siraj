{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "mui-mcp": {
      "type": "local",
      "command": ["bun", "x", "-y", "@mui/mcp@latest"],
      "enabled": true
    },
    "next-devtools": {
      "command": ["bun", "x", "-y", "next-devtools-mcp@latest"],
      "enabled": true
    }
  }
}
