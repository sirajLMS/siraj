{
  "sonarlint.analysisExcludesStandalone": "**/.next-test/**,**/messages/**,**theme/palette/**,**/.scannerwork/**,**/.git/**,**/.agent/**,**/.ai/**,docs/**,backend/drizzle/**,**/node_modules/**,**/.next/**,**/dist/**,**/out/**,**/build/**,**/.storybook/**,**/*.stories.@(js|jsx|ts|tsx),**/*.test.@(js|jsx|ts|tsx),**/__tests__/**,**/*.d.ts,**/public/**,**/coverage/**,**/scripts/**,**/mockData/**,**/decorators/**,**/graphql/generated/**,storybook-static/**",
  "codescene.enableAutoRefactor": false,
  "codescene.enableTelemetry": false,
  "js/ts.tsdk.path": "node_modules/@typescript/native-preview",
  "chat.mcp.serverSampling": {
    "siraj/.mcp.json: next-devtools": {
      "allowedModels": []
    }
  },
  "chat.utilitySmallModel": "customendpoint/nvidia/z-ai/glm-5.2",
  "chat.defaultModel": "customendpoint/nvidia/z-ai/glm-5.2",
  "chat.newSession.defaultMode": "customendpoint/nvidia/z-ai/glm-5.2",
  "chat.planAgent.defaultModel": "Glm-5.2 (customendpoint)",
  "chat.utilityModel": "customendpoint/nvidia/z-ai/glm-5.2",
  "chat.permissions.default": "autopilot",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },
  "json.schemas": [
    {
      "fileMatch": ["*appearance*.json", ".brand.json"],
      "url": "./shared/schemas/appearance.schema.json"
    }
  ]
}
