{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "exit 0",
  "git": {
    "deploymentEnabled": {
      "dev": false
    }
  },
  "fluid": true,
  "crons": [
    {
      "path": "/api/fx/refresh",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/class-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/whatsapp-sync-sweep",
      "schedule": "13 6 * * *"
    },
    {
      "path": "/api/cron/whatsapp-webhook-sweep",
      "schedule": "18 6 * * *"
    }
  ]
}
