{
  "name": "siraj",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000 -H 0.0.0.0",
    "debug": "next dev --turbopack -p 3000 -H 0.0.0.0",
    "dev:safe": "bun scripts/safe-dev.ts",
    "dev:full": "bash ../scripts/dev.sh",
    "dev:inspect": "NODE_OPTIONS='--inspect' next dev --turbopack -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint --fix --cache --cache-location .eslintcache --concurrency=auto",
    "lint:perf": "TIMING=1 eslint app/ frontend/ backend/ scripts/ --cache --cache-location .eslintcache --concurrency=auto",
    "format": "bunx @biomejs/biome format --write .",
    "biome:check": "bunx @biomejs/biome check --write --unsafe .",
    "biome:lint": "bunx @biomejs/biome lint --write .",
    "biome:imports": "bunx @biomejs/biome check --write --formatter-enabled=false --linter-enabled=false .",
    "tsgo": "tsgo -b --noEmit --extendedDiagnostics",
    "generate:gqlSchema": "bun run backend/graphql/generateGqlSchema.ts",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "test": "bun test --timeout=60000",
    "codescene": "bun run scripts/health/codescene/main.ts --scan",
    "quality-gate": "bun run scripts/quality-gate.ts --timeout=300000",
    "quality-gate:fresh": "bun run scripts/quality-gate.ts --timeout=300000 --fresh",
    "sonar-scan": "bun run scripts/health/sonar/ts/main.ts --scan",
    "sonar-result": "bun run scripts/health/sonar/ts/main.ts --result",
    "sonar-full": "bun run scripts/health/sonar/ts/main.ts --full",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "prepare": "husky",
    "db": "bun run scripts/dbActions.ts"
  },
