{
  "name": "siraj",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000 -H 0.0.0.0",
    "debug": "next dev --turbopack -p 3000 -H 0.0.0.0",
    "dev:safe": "bun scripts/safe-dev.ts",
    "dev:inspect": "NODE_OPTIONS='--inspect' next dev --turbopack -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "format": "bunx @biomejs/biome format --write .",
    "biome:check": "bunx @biomejs/biome check --write --unsafe .",
    "biome:lint": "bunx @biomejs/biome lint --write .",
    "biome:imports": "bunx @biomejs/biome check --write --formatter-enabled=false --linter-enabled=false .",
    "tsgo": "tsgo -b --noEmit",
    "generate:gqlSchema": "bun run backend/graphql/generateGqlSchema.ts",
    "generate:iana-timezones": "bun run scripts/generate-iana-timezone-enum.ts",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "test": "bun test --timeout=60000",
    "test:coverage": "bun test --coverage --timeout=60000",
    "test:db": "bun scripts/run-db-tests-parallel.ts",
    "test:db:sequential": "bun test backend/db/test/ --timeout=60000",
    "test:db:coverage": "bun test --coverage backend/db/test/ --timeout=60000",
    "test:graphql": "bun test frontend/graphql/test/ --timeout=120000",
    "test:graphql:coverage": "bun test --coverage frontend/graphql/test/ --timeout=120000",
    "test:ui": "bun test test/ui/ --timeout=120000",
    "test:ui:components": "bun test test/ui/components/ --timeout=30000",
    "test:ui:components:coverage": "bun test --coverage test/ui/components/ --timeout=30000",
    "test:ui:e2e": "bun test test/ui/e2e/ --timeout=120000",
    "codescene": "bun run scripts/health/codescene/main.ts --scan",
    "lint": "bun run scripts/lint-queue-client.ts",
    "quality-gate": "bun run scripts/quality-gate.ts",
    "quality-gate:fresh": "bun run scripts/quality-gate.ts --fresh",
    "sonar-scan": "bun run scripts/health/sonar/ts/main.ts --scan",
    "sonar-result": "bun run scripts/health/sonar/ts/main.ts --result",
    "sonar-full": "bun run scripts/health/sonar/ts/main.ts --full",
    "storybook": "NODE_OPTIONS='--no-deprecation' storybook dev -p 6006",
    "build-storybook": "NODE_OPTIONS='--no-deprecation' storybook build",
    "prepare": "husky",
    "postinstall": "rm -rf node_modules/*/node_modules/typescript && bun -e \"const fs = require('fs'); const file = 'node_modules/typescript/lib/version.cjs'; if (fs.existsSync(file)) fs.writeFileSync(file, 'module.exports = { ...require(\\\"@typescript/typescript6\\\"), version: \\\"7.0.2\\\", versionMajorMinor: \\\"7.0\\\" };');\"",
    "db": "bun run scripts/dbActions/index.ts"
  },
