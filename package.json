{
  "name": "siraj",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev --turbopack -p 3000 -H 0.0.0.0",
    "debug": "NEXT_DIST_DIR=.next-dev next dev --turbopack -p 3000 -H 0.0.0.0",
    "dev:safe": "NEXT_DIST_DIR=.next-dev bun scripts/safe-dev.ts",
    "dev:https": "NEXT_DIST_DIR=.next-dev next dev --turbopack --experimental-https -p 3000 -H 0.0.0.0",
    "dev:inspect": "NEXT_DIST_DIR=.next-dev NODE_OPTIONS='--inspect' next dev --turbopack -p 3000 -H 0.0.0.0",
    "ngrok": "bun run scripts/ngrok.ts",
    "whatsapp:webhook-setup": "bun run scripts/whatsapp-webhook-setup.ts",
    "prebuild": "tsx scripts/locale-snapshots.ts && tsx scripts/build/generate-vercel-config.ts",
    "postbuild": "bun run scripts/build/sanitize-prebuilt-refs.ts",
    "locale:snapshots": "tsx scripts/locale-snapshots.ts",
    "build": "tsx scripts/lib/run-locked-cmd.ts build NODE_ENV=production next build",
    "start": "next start -p 4000 -H 0.0.0.0",
    "format": "bunx @biomejs/biome format --write .",
    "biome:check": "bun run scripts/lib/run-locked-cmd.ts biome:check bunx @biomejs/biome check --write --unsafe .",
    "biome:lint": "bunx @biomejs/biome lint --write .",
    "biome:imports": "bunx @biomejs/biome check --write --formatter-enabled=false --linter-enabled=false .",
    "tsgo": "bun run scripts/restore-next-env-dts.ts && bun run scripts/lib/run-locked-cmd.ts tsgo tsgo -b --noEmit",
    "generate:gqlSchema": "TEST_SERVER=1 bun run backend/graphql/generateGqlSchema.ts",
    "generate:iana-timezones": "bun run scripts/generate-iana-timezone-enum.ts",
    "generate:jwt-secrets": "bun run scripts/generate-jwt-secrets.ts",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "test": "bun run scripts/lib/run-locked-cmd.ts test bun --env-file=.env.test test --timeout=60000",
    "test:coverage": "bun run scripts/lib/run-locked-cmd.ts test:coverage bun --env-file=.env.test test --coverage --timeout=60000",
    "test:db": "bun --env-file=.env.test test/scripts/run-db-tests-parallel.ts",
    "test:db:sequential": "bun run scripts/lib/run-locked-cmd.ts test:db:sequential bun --env-file=.env.test test backend/db/test/ --timeout=60000",
    "test:db:coverage": "bun run scripts/lib/run-locked-cmd.ts test:db:coverage bun --env-file=.env.test test --coverage backend/db/test/ --timeout=60000",
    "test:services": "bun --env-file=.env.test test/scripts/run-services-tests-parallel.ts",
    "test:services:sequential": "bun run scripts/lib/run-locked-cmd.ts test:services:sequential bun --env-file=.env.test test backend/services/ --timeout=60000",
    "test:services:coverage": "bun run scripts/lib/run-locked-cmd.ts test:services:coverage bun --env-file=.env.test test --coverage backend/services/ --timeout=60000",
    "test:cron": "bun run scripts/lib/run-locked-cmd.ts test:cron bun --env-file=.env.test test backend/services/cron/test/ backend/db/test/repo/cron.repository.test.ts backend/lib/cron-auth.test.ts app/api/cron/ --timeout=60000",
    "test:integration": "bun --env-file=.env.test test/scripts/run-integration-tests-parallel.ts",
    "test:integration:sequential": "bun run scripts/lib/run-locked-cmd.ts test:integration:sequential bun --env-file=.env.test test test/integration/ --timeout=120000",
    "test:graphql": "bun run scripts/lib/run-locked-cmd.ts test:graphql bun run test/scripts/run-server-tests.ts",
    "test:graphql:coverage": "bun run scripts/lib/run-locked-cmd.ts test:graphql:coverage bun run test/scripts/run-server-tests.ts --coverage",
    "test:simulate": "bun run scripts/lib/run-locked-cmd.ts test:simulate bun --env-file=.env.test test --parallel=1 test/simulate/ --timeout=120000",
    "test:workflows": "bun --env-file=.env.test test/scripts/run-workflows-tests-parallel.ts",
    "test:workflows:sequential": "bun run scripts/lib/run-locked-cmd.ts test:workflows:sequential bun --env-file=.env.test test test/workflows/ --timeout=120000",
    "test:live-fx": "bun run scripts/lib/run-locked-cmd.ts test:live-fx bun --env-file=.env.test test --preload ./test/integration/preload/live-fx-preload.ts test/integration/fx/ --timeout=120000",
    "test:live-comm": "bun run scripts/lib/run-locked-cmd.ts test:live-comm bun --env-file=.env.test test --preload ./test/integration/preload/live-comm-preload.ts test/integration/communication/ --timeout=120000",
    "codescene": "bun run scripts/health/codescene/main.ts --scan",
    "lint": "bun run scripts/lint-service.ts",
    "lint:type-aware": "bun run scripts/lint-service.ts --type-aware",
    "lint:fix": "bun run scripts/lint-service.ts --fix",
    "oxlint": "bun run scripts/lib/run-locked-cmd.ts oxlint oxlint --deny-warnings --ignore-path .gitignore",
    "check:duplicates": "bun run scripts/lib/run-locked-cmd.ts check:duplicates jscpd",
    "check:unused": "knip --treat-config-hints-as-errors --treat-tag-hints-as-errors",
    "check:deps": "bun run scripts/lib/run-locked-cmd.ts check:deps depcruise --config .dependency-cruiser.js app backend frontend shared",
    "quality-gate": "bun run scripts/quality-gate.ts",
    "quality-gate:fresh": "bun run scripts/quality-gate.ts --fresh",
    "sonar-scan": "bun run scripts/health/sonar/ts/main.ts --scan",
    "sonar-result": "bun run scripts/health/sonar/ts/main.ts --result",
    "sonar-full": "bun run scripts/health/sonar/ts/main.ts --full",
    "storybook": "NODE_OPTIONS='--no-deprecation' storybook dev -p 6006",
    "build-storybook": "NODE_OPTIONS='--no-deprecation' storybook build",
    "prepare": "husky",
    "postinstall": "rm -rf node_modules/*/node_modules/typescript",
    "db": "bun --no-env-file run scripts/dbActions/index.ts",
    "db:sqlite": "bun --no-env-file run scripts/dbActions/index.ts --env-file=.env.sqlite",
    "db:sqlite:push": "bun --no-env-file run scripts/dbActions/index.ts --env-file=.env.sqlite push",
    "db:sqlite:seed": "bun --no-env-file run scripts/dbActions/index.ts --env-file=.env.sqlite seed",
    "db:sqlite:studio": "bun --no-env-file run scripts/dbActions/index.ts --env-file=.env.sqlite studio",
    "db:sqlite:migrate": "bun --no-env-file run scripts/dbActions/index.ts --env-file=.env.sqlite migrate",
    "db:sqlite:generate": "DB_PROVIDER=sqlite bunx drizzle-kit generate --config=drizzle.config.sqlite.ts",
    "test:db:sqlite": "bun --no-env-file --env-file=.env.sqlite test/scripts/run-db-tests-parallel.ts",
    "test:services:sqlite": "bun --no-env-file --env-file=.env.sqlite test/scripts/run-services-tests-parallel.ts",
    "test:graphql:sqlite": "TEST_ENV_FILE=.env.sqlite bun run scripts/lib/run-locked-cmd.ts test:graphql:sqlite bun run test/scripts/run-server-tests.ts",
    "cron:worker": "bun run scripts/cron-worker.ts",
    "validate:seed-assets": "bun run scripts/validate-seed-assets.ts",
    "generate:icons": "bun scripts/generate-icons.ts",
    "quota:expire": "bun run scripts/quota-expiry-sweeper.ts",
    "quota:reminder": "bun run scripts/quota-reminder-cron.ts",
    "ondemand:generate": "bun run scripts/ondemand-instance-generator.ts",
    "ondemand:resolve": "bun run scripts/ondemand-no-credits-resolver.ts",
    "ondemand:teacher-digest": "bun run scripts/ondemand-teacher-digest-cron.ts",
    "validate:mermaid": "bun run scripts/validate-mermaid.ts"
  },
