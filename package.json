{
  "name": "siraj",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev --turbopack -p 3000 -H 0.0.0.0",
    "debug": "NEXT_DIST_DIR=.next-dev next dev --turbopack -p 3000 -H 0.0.0.0",
    "dev:safe": "NEXT_DIST_DIR=.next-dev bun scripts/safe-dev.ts",
    "dev:inspect": "NEXT_DIST_DIR=.next-dev NODE_OPTIONS='--inspect' next dev --turbopack -p 3000 -H 0.0.0.0",
    "prebuild": "bun run locale:snapshots",
    "locale:snapshots": "bun run scripts/locale-snapshots.ts",
    "build": "next build",
    "start": "next start -p 4000 -H 0.0.0.0",
    "format": "bunx @biomejs/biome format --write .",
    "biome:check": "bunx @biomejs/biome check --write --unsafe .",
    "biome:lint": "bunx @biomejs/biome lint --write .",
    "biome:imports": "bunx @biomejs/biome check --write --formatter-enabled=false --linter-enabled=false .",
    "tsgo": "bun run scripts/restore-next-env-dts.ts && tsgo -b --noEmit",
    "generate:gqlSchema": "bun run backend/graphql/generateGqlSchema.ts",
    "generate:iana-timezones": "bun run scripts/generate-iana-timezone-enum.ts",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "test": "bun --env-file=.env.test test --timeout=60000",
    "test:coverage": "bun --env-file=.env.test test --coverage --timeout=60000",
    "test:db": "bun --env-file=.env.test scripts/run-db-tests-parallel.ts",
    "test:db:sequential": "bun --env-file=.env.test test backend/db/test/ --timeout=60000",
    "test:db:coverage": "bun --env-file=.env.test test --coverage backend/db/test/ --timeout=60000",
    "test:services": "bun --env-file=.env.test scripts/run-services-tests-parallel.ts",
    "test:services:sequential": "bun --env-file=.env.test test backend/services/ --timeout=60000",
    "test:services:coverage": "bun --env-file=.env.test test --coverage backend/services/ --timeout=60000",
    "test:cron": "bun --env-file=.env.test test backend/services/cron/test/ backend/db/test/repo/cron.repository.test.ts backend/lib/cron-auth.test.ts app/api/cron/ --timeout=60000",
    "test:integration": "bun --env-file=.env.test scripts/run-integration-tests-parallel.ts",
    "test:integration:sequential": "bun --env-file=.env.test test test/integration/ --timeout=120000",
    "test:graphql": "bun --env-file=.env.test test frontend/common/graphql/test/ --timeout=120000",
    "test:graphql:coverage": "bun --env-file=.env.test test --coverage frontend/common/graphql/test/ --timeout=120000",
    "test:ui": "bun run test:ui:components && bun run test:ui:e2e && bun run test:ui:static",
    "test:ui:components": "TEST_SERVER_MODE=production bun --env-file=.env.test test test/ui/components/ --preload ./test/ui/test-env.ts --preload ./test/ui/components/happydom-preload.ts --preload ./test/ui/components/next-dynamic-mock.ts",
    "test:ui:components:coverage": "TEST_SERVER_MODE=production bun --env-file=.env.test test --coverage test/ui/components/ --preload ./test/ui/test-env.ts --preload ./test/ui/components/happydom-preload.ts --preload ./test/ui/components/next-dynamic-mock.ts",
    "test:ui:e2e": "TEST_SERVER_MODE=production bun --env-file=.env.test test test/ui/e2e/ --preload ./test/ui/test-env.ts --timeout=120000",
    "test:ui:static": "TEST_SERVER_MODE=production bun --env-file=.env.test test test/ui/mobile-desktop-isolation.test.ts --preload ./test/ui/test-env.ts",
    "test:ui:kill": "bun run scripts/kill-test-ui-servers.ts",
    "build:test": "bun run scripts/build-test.ts",
    "test:live-fx": "bun --env-file=.env.test test --preload ./test/integration/preload/live-fx-preload.ts test/integration/fx/ --timeout=120000",
    "test:live-comm": "bun --env-file=.env.test test --preload ./test/integration/preload/live-comm-preload.ts test/integration/communication/ --timeout=120000",
    "codescene": "bun run scripts/health/codescene/main.ts --scan",
    "lint": "bun -e \"const{requestFullRepoLint}=require('./scripts/lint-queue-client.ts');const r=await requestFullRepoLint('cli');process.stdout.write(r.output||'');process.exit(r.exitCode??0)\"",
    "lint:server": "~/.bun/bin/bun run scripts/lint-queue-server.ts",
    "lint:fix": "NODE_OPTIONS='-r ./scripts/ts6-eslint-patch.cjs' eslint . --fix --concurrency=auto --cache",
    "quality-gate": "bun run scripts/quality-gate.ts",
    "quality-gate:fresh": "bun run scripts/quality-gate.ts --fresh",
    "sonar-scan": "bun run scripts/health/sonar/ts/main.ts --scan",
    "sonar-result": "bun run scripts/health/sonar/ts/main.ts --result",
    "sonar-full": "bun run scripts/health/sonar/ts/main.ts --full",
    "storybook": "NODE_OPTIONS='--no-deprecation' storybook dev -p 6006",
    "build-storybook": "NODE_OPTIONS='--no-deprecation' storybook build",
    "prepare": "husky",
    "postinstall": "rm -rf node_modules/*/node_modules/typescript && bun -e \"const fs = require('fs'); const file = 'node_modules/typescript/lib/version.cjs'; if (fs.existsSync(file)) fs.writeFileSync(file, 'module.exports = { ...require(\\\"@typescript/typescript6\\\"), version: \\\"7.0.2\\\", versionMajorMinor: \\\"7.0\\\" };'); const pkg = 'node_modules/typescript/package.json'; if (fs.existsSync(pkg)) { const p = JSON.parse(fs.readFileSync(pkg, 'utf8')); if (p.type === 'module') { p.type = 'commonjs'; fs.writeFileSync(pkg, JSON.stringify(p, null, 2)); } }\"",
    "db": "bun --no-env-file run scripts/dbActions/index.ts",
    "cron:worker": "bun run scripts/cron-worker.ts",
    "validate:seed-assets": "bun run scripts/validate-seed-assets.ts",
    "generate:icons": "bun scripts/generate-icons.ts"
  },
