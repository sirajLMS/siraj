      }),
      zIndex: (theme) => theme.zIndex.tooltip + 1,
      pointerEvents: 'none',
    }}>
      {slot === 'fill' ? 'F' : 'S'}: {color.hex} {Math.round(color.alpha * 100)}%
    </Box>
  );
}
```

A small monospace label that sits right of the cursor showing the pixel color and the active paint slot ('F' for fill / 'S' for stroke). Updates in real time as the cursor moves.

