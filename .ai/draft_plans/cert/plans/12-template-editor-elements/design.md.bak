  fillColor: string;
  fillOpacity: string;
  fillRule: string;
  fillEvenOdd: string;
  fillNonzero: string;
  totalLength: string;
  anchorCount: (count: number) => string;
  bboxDimensions: string;
  pathClosed: string;
  pathOpen: string;
  toggleClosed: string;
  reversePath: string;
  simplify: string;
  smooth: string;
  offset: string;
  exportSvg: string;
  simplifyTitle: string;
  simplifyHint: string;
  smoothTitle: string;
  smoothHint: string;
  offsetTitle: string;
  offsetHint: string;
