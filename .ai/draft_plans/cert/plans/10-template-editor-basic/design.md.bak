    isoAngleHint: string;
  };
}

interface SmartGuideLabels {
  toggle: string;
  snapSensitivity: string;
  showDistance: string;
  showEqualSpacing: string;
  showEqualSize: string;
}

interface SnapLabels {
  snapTo: string;
  grid: string;
  guides: string;
  layers: string;
  pixels: string;
  artboard: string;
  threshold: string;
  priority: string;
}

interface ViewMenuLabels {
  title: string;
  rulers: string;
  guides: string;
  grid: string;
  lockGuides: string;
  clearGuides: string;
  newGuide: string;
  smartGuides: string;
  guidePresets: string;
  printPresets: string;
  gridSettings: string;
  guideGridSettings: string;
  snapTo: string;
  shortcuts: {
    rulers: string;
    guides: string;
    grid: string;
    lockGuides: string;
    newGuide: string;
    smartGuides: string;
    gridSettings: string;
    snapToGrid: string;
