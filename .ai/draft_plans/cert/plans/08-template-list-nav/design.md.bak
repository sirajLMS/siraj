                    │                 ├─► Zustand: templateListStore             │
                    │                 │   (searchQuery, debouncedSearch,        │
                    │                 │    filters, cursor, viewMode,           │
                    │                 │    selectedIds, bulkBarOpen)            │
                    │                 │                                         │
                    │                 ├─► <ResponsiveViewSwitch>                │
                    │                 │      ├─ Desktop: DesktopTemplateListView│
                    │                 │      │    ├─ DesktopPageHeader           │
                    │                 │      │    ├─ SearchBar (debounced 300ms)│
