{
  "mcpServers": {
    "next-devtools": {
      "command": "bun",
      "args": [
        "x",
        "-y",
        "next-devtools-mcp@latest"
      ]
    },
    "mui-mcp": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "x",
        "-y",
        "@mui/mcp@latest"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "bun",
        "x",
        "-y",
        "@playwright/mcp@0.0.38"
      ]
    }
  }
}
