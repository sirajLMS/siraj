    await assertCatalogAdmin(actorUserId, locale);
    return SupportedOnlineAccountRepository.create(input, undefined);
  }

  export async function updateOnlineAccount(
    actorUserId: string,
    id: string,
    input: UpdateSupportedOnlineAccountInput,
    locale?: string
