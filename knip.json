{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/route.ts",
    "app/**/loading.tsx",
    "app/**/error.tsx",
    "app/**/template.tsx",
    "scripts/**/*.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "backend/**/*.{ts,tsx}",
    "frontend/**/*.{ts,tsx}",
    "shared/**/*.{ts,tsx}",
    "scripts/**/*.{ts,tsx}"
  ],
  "ignore": [
    "**/.*/**",
    "!.storybook/**",
    "out/**",
    "build/**",
    "dist/**",
    "logs/**",
    "storage/**",
    "scratch/**",
    "draft/**",
    "public/**",
    "storybook-static/**",
    "docs/**",
    "**/generated/**",
    "**/unRefactored_tests/**",
    "**/*.d.ts"
  ]
}
