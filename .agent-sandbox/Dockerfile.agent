# ============================================================
# Siraj Agent Sandbox - Base Dockerfile
# ============================================================
# Bakes node_modules INTO the image so containers start instantly
# without downloading anything. Rebuild when package.json/bun.lock
# changes.
#
# Build:    docker build -t siraj-agent-base -f .agent-sandbox/Dockerfile.agent .
# Rebuild:  docker build --no-cache -t siraj-agent-base -f .agent-sandbox/Dockerfile.agent .
# ============================================================

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get -y install --no-install-recommends \
    curl wget git ca-certificates unzip openssl xxd \
    postgresql-client procps bash-completion \
    libglib2.0-0 libnss3 libatk-bridge2.0-0 libdrm2 \
    libxcomposite1 libxdamage1 libxrandr2 libgbm1 \
    libxss1 libasound2 libcups2 libxkbcommon0 \
    libgtk-3-0 libpangocairo-1.0-0 libatk1.0-0 \
    libcairo-gobject2 libgdk-pixbuf-2.0-0 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV BUN_INSTALL=/usr/local
RUN curl -fsSL https://bun.sh/install | bash \
    && groupadd --gid 1001 agent \
    && useradd --uid 1001 --gid agent --shell /bin/bash --create-home agent \
    && mkdir -p /workspaces/siraj \
    && chown -R agent:agent /workspaces

COPY .agent-sandbox/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER agent
WORKDIR /workspaces/siraj

# --- Bake node_modules into the image (one-time install) ---
# Copy only dependency manifests first for Docker layer caching
COPY --chown=agent:agent package.json bun.lock bunfig.toml /workspaces/siraj/

RUN bun install --ignore-scripts 2>&1 \
    && echo "[agent-sandbox] Dependencies baked into image."

ENV NODE_ENV=development \
    PATH="/usr/local/bin:/home/agent/.bun/bin:${PATH}" \
    BUN_INSTALL=/usr/local \
    NEXT_TELEMETRY_DISABLED=1 \
    PUPPETEER_SKIP_DOWNLOAD=true

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["sleep", "infinity"]
