sonar.projectKey=projectKey
sonar.projectName=projectName
sonar.projectVersion=1.0

# Source code
sonar.sources=src
sonar.sourceEncoding=UTF-8

# Exclusions
#   **/.*/**  — ignores ALL dot-directories anywhere in the tree (e.g. .next,
#               .git, .storybook, .scannerwork, ...). One pattern replaces the
#               previous hand-maintained list that missed new dot dirs.
sonar.exclusions=**/.*/**,**/node_modules/**,**/dist/**,**/out/**,**/build/**,**/*.stories.@(js|jsx|ts|tsx),**/*.test.@(js|jsx|ts|tsx),**/__tests__/**,**/*.d.ts,**/public/**,**/coverage/**,**/scripts/**,**/mockData/**,**/decorators/**

# TypeScript/JavaScript settings
sonar.javascript.lcov.reportPaths=coverage/lcov.info
sonar.typescript.tsconfigPath=tsconfig.json

# SCM settings - scan working directory including uncommitted changes
sonar.scm.disabled=true
