  "success": {
    "added": {
      "__fn": "(hours) => {\n      if (hours === 1)\n        return \"\\u062A\\u0645\\u062A \\u0625\\u0636\\u0627\\u0641\\u0629 \\u0633\\u0627\\u0639\\u0629 \\u0645\\u0639\\u062A\\u0645\\u062F\\u0629 \\u0648\\u0627\\u062D\\u062F\\u0629\";\n      if (hours === 2)\n        return \"\\u062A\\u0645\\u062A \\u0625\\u0636\\u0627\\u0641\\u0629 \\u0633\\u0627\\u0639\\u062A\\u064A\\u0646 \\u0645\\u0639\\u062A\\u0645\\u062F\\u062A\\u064A\\u0646\";\n      if (hours >= 3 && hours <= 10)\n        return `\\u062A\\u0645\\u062A \\u0625\\u0636\\u0627\\u0641\\u0629 ${hours} \\u0633\\u0627\\u0639\\u0627\\u062A \\u0645\\u0639\\u062A\\u0645\\u062F\\u0629`;\n      return `\\u062A\\u0645\\u062A \\u0625\\u0636\\u0627\\u0641\\u0629 ${hours} \\u0633\\u0627\\u0639\\u0629 \\u0645\\u0639\\u062A\\u0645\\u062F\\u0629`;\n    }"
    },
    "subtracted": {
      "__fn": "(hours) => {\n      if (hours === 1)\n        return \"\\u062A\\u0645 \\u062E\\u0635\\u0645 \\u0633\\u0627\\u0639\\u0629 \\u0645\\u0639\\u062A\\u0645\\u062F\\u0629 \\u0648\\u0627\\u062D\\u062F\\u0629\";\n      if (hours === 2)\n        return \"\\u062A\\u0645 \\u062E\\u0635\\u0645 \\u0633\\u0627\\u0639\\u062A\\u064A\\u0646 \\u0645\\u0639\\u062A\\u0645\\u062F\\u062A\\u064A\\u0646\";\n      if (hours >= 3 && hours <= 10)\n        return `\\u062A\\u0645 \\u062E\\u0635\\u0645 ${hours} \\u0633\\u0627\\u0639\\u0627\\u062A \\u0645\\u0639\\u062A\\u0645\\u062F\\u0629`;\n      return `\\u062A\\u0645 \\u062E\\u0635\\u0645 ${hours} \\u0633\\u0627\\u0639\\u0629 \\u0645\\u0639\\u062A\\u0645\\u062F\\u0629`;\n    }"
    },
    "carryover": {
      "__fn": "(hours, teacher) => {\n      if (hours === 1)\n        return `\\u062A\\u0645 \\u062E\\u0635\\u0645 \\u0633\\u0627\\u0639\\u0629 \\u0648\\u0627\\u062D\\u062F\\u0629 \\u0648\\u062A\\u0631\\u062D\\u064A\\u0644\\u0647\\u0627 \\u0625\\u0644\\u0649 ${teacher}`;\n      if (hours === 2)\n        return `\\u062A\\u0645 \\u062E\\u0635\\u0645 \\u0633\\u0627\\u0639\\u062A\\u064A\\u0646 \\u0648\\u062A\\u0631\\u062D\\u064A\\u0644\\u0647\\u0645\\u0627 \\u0625\\u0644\\u0649 ${teacher}`;\n      if (hours >= 3 && hours <= 10)\n        return `\\u062A\\u0645 \\u062E\\u0635\\u0645 ${hours} \\u0633\\u0627\\u0639\\u0627\\u062A \\u0648\\u062A\\u0631\\u062D\\u064A\\u0644\\u0647\\u0627 \\u0625\\u0644\\u0649 ${teacher}`;\n      return `\\u062A\\u0645 \\u062E\\u0635\\u0645 ${hours} \\u0633\\u0627\\u0639\\u0629 \\u0648\\u062A\\u0631\\u062D\\u064A\\u0644\\u0647\\u0627 \\u0625\\u0644\\u0649 ${teacher}`;\n    }"
    }
