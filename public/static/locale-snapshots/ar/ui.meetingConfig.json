    },
    "reconnectedProviders": {
      "__fn": "(count) => {\n    if (count === 1)\n      return \"\\u062A\\u0645\\u062A \\u0625\\u0639\\u0627\\u062F\\u0629 \\u0631\\u0628\\u0637 \\u0645\\u0632\\u0648\\u062F \\u0648\\u0627\\u062D\\u062F\";\n    if (count === 2)\n      return \"\\u062A\\u0645\\u062A \\u0625\\u0639\\u0627\\u062F\\u0629 \\u0631\\u0628\\u0637 \\u0645\\u0632\\u0648\\u062F\\u064A\\u0646\";\n    return `\\u062A\\u0645\\u062A \\u0625\\u0639\\u0627\\u062F\\u0629 \\u0631\\u0628\\u0637 ${count} \\u0645\\u0632\\u0648\\u062F\\u064A\\u0646`;\n  }"
    },
    "reconnectFailedProviders": {
      "__fn": "(count) => {\n    if (count === 1)\n      return \"\\u0641\\u0634\\u0644 \\u0625\\u0639\\u0627\\u062F\\u0629 \\u0631\\u0628\\u0637 \\u0645\\u0632\\u0648\\u062F \\u0648\\u0627\\u062D\\u062F\";\n    if (count === 2)\n      return \"\\u0641\\u0634\\u0644 \\u0625\\u0639\\u0627\\u062F\\u0629 \\u0631\\u0628\\u0637 \\u0645\\u0632\\u0648\\u062F\\u064A\\u0646\";\n    return `\\u0641\\u0634\\u0644 \\u0625\\u0639\\u0627\\u062F\\u0629 \\u0631\\u0628\\u0637 ${count} \\u0645\\u0632\\u0648\\u062F\\u064A\\u0646`;\n  }"
    },
    "reconnectAllAriaLabel": "إعادة ربط جميع المزودين المنتهية",
    "expiresInDays": {
      "__fn": "(days) => {\n    if (days === 1)\n      return \"\\u064A\\u0646\\u062A\\u0647\\u064A \\u062E\\u0644\\u0627\\u0644 \\u064A\\u0648\\u0645 \\u0648\\u0627\\u062D\\u062F\";\n    if (days === 2)\n      return \"\\u064A\\u0646\\u062A\\u0647\\u064A \\u062E\\u0644\\u0627\\u0644 \\u064A\\u0648\\u0645\\u064A\\u0646\";\n    return `\\u064A\\u0646\\u062A\\u0647\\u064A \\u062E\\u0644\\u0627\\u0644 ${days} \\u0623\\u064A\\u0627\\u0645`;\n  }"
    },
    "expiresInHours": {
      "__fn": "(hours) => {\n    if (hours === 1)\n      return \"\\u064A\\u0646\\u062A\\u0647\\u064A \\u062E\\u0644\\u0627\\u0644 \\u0633\\u0627\\u0639\\u0629 \\u0648\\u0627\\u062D\\u062F\\u0629\";\n    if (hours === 2)\n      return \"\\u064A\\u0646\\u062A\\u0647\\u064A \\u062E\\u0644\\u0627\\u0644 \\u0633\\u0627\\u0639\\u062A\\u064A\\u0646\";\n    return `\\u064A\\u0646\\u062A\\u0647\\u064A \\u062E\\u0644\\u0627\\u0644 ${hours} \\u0633\\u0627\\u0639\\u0627\\u062A`;\n  }"
    },
