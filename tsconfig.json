{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "skipLibCheck": true,
    "moduleDetection": "force",
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./*"]
    },
    "allowJs": true,
    "types": ["bun"]
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    ".storybook/*.ts",
    ".storybook/*.tsx",
    "next-env.d.ts",
    "**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "dist/types/**/*.ts",
    "dist/dev/types/**/*.ts",
    ".next-test/dev/types/**/*.ts",
    ".next-test/dev/dev/types/**/*.ts",
    ".next-test/types/**/*.ts",
    ".next-test-*/dev/types/**/*.ts",
    ".next-test-*/dev/dev/types/**/*.ts",
    ".next-test-*/types/**/*.ts"
  ],
  "exclude": [
    // Ignore ALL dot-directories anywhere in the tree (e.g. .ai, .git, .cursor,
    // .vscode, .scannerwork, .husky, .agents, ...). Does NOT affect Next.js's
    // generated types in .next/ and .next-test*/ — those are pulled in explicitly
    // via the `include` block above (TS applies `exclude` only to files reached via
    // ambient/walked discovery, not to explicit `include` entries — so .next types
    // stay included).
    "**/.*/**",
    // Build output / dependency dirs that don't start with a dot.
    "node_modules",
    "dist",
    "out",
    "build",
    "storybook-static",
    // Source subtrees deliberately excluded from type-checking.
    "draft",
    "frontend/common/graphql/generated",
    "**/unRefactored_tests"
  ]
}
