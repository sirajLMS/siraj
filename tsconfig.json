{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "skipLibCheck": true,
    "moduleDetection": "force",
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./*"]
    },
    "allowJs": true,
    "types": ["bun"]
  },
  "include": [
    "next-env.d.ts",
    "environment.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "backend/**/*.ts",
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "shared/**/*.ts",
    "shared/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": [
    // Dot-directories
    "**/.ai/**",
    "**/.agents/**",
    "**/.codescene/**",
    "**/.cursor/**",
    "**/.git/**",
    "**/.github/**",
    "**/.husky/**",
    "**/.kiro/**",
    "**/.next/**",
    "**/.next-*/**",
    "**/.playwright-mcp/**",
    "**/.scannerwork/**",
    "**/.stakpak/**",
    "**/.storybook/**",
    "**/.vercel/**",
    "**/.vscode/**",
    // Build output / dependency dirs
    "node_modules",
    "dist",
    "out",
    "build",
    "storybook-static",
    // Tests, stories, mocks & non-production files
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "test/**",
    "scratch/**",
    // Source subtrees deliberately excluded from type-checking
    "draft",
    "frontend/common/graphql/generated",
    "**/unRefactored_tests"
  ]
}
