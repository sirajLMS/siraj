{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "skipLibCheck": true,
    "moduleDetection": "force",
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./*"]
    },
    "allowJs": true,
    "types": ["bun"]
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "next-env.d.ts",
    "**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next-dev/types/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-test-3054/dev/types/**/*.ts",
    ".next-test-3054/dev/dev/types/**/*.ts",
    ".next-test-3055/dev/types/**/*.ts",
    ".next-test-3055/dev/dev/types/**/*.ts",
    ".next-test-3089/dev/types/**/*.ts",
    ".next-test-3089/dev/dev/types/**/*.ts",
    ".next-test-3029/dev/types/**/*.ts",
    ".next-test-3029/dev/dev/types/**/*.ts",
    ".next-test-3180/dev/types/**/*.ts",
    ".next-test-3180/dev/dev/types/**/*.ts",
    ".next-test-3001/dev/types/**/*.ts",
    ".next-test-3001/dev/dev/types/**/*.ts",
    ".next-test-3166/dev/types/**/*.ts",
    ".next-test-3166/dev/dev/types/**/*.ts",
    ".next-test-3167/dev/types/**/*.ts",
    ".next-test-3167/dev/dev/types/**/*.ts",
    ".next-test-3163/dev/types/**/*.ts",
    ".next-test-3163/dev/dev/types/**/*.ts",
    ".next-test-3164/dev/types/**/*.ts",
    ".next-test-3164/dev/dev/types/**/*.ts"
  ],
  "exclude": [
    // Dot-directories (except `.storybook`, which is explicitly included above).
    "**/.ai/**",
    "**/.agents/**",
    "**/.codescene/**",
    "**/.cursor/**",
    "**/.git/**",
    "**/.github/**",
    "**/.husky/**",
    "**/.kiro/**",
    "**/.next/**",
    "**/.next-dev/**",
    "**/.next-test*/**",
    "**/.playwright-mcp/**",
    "**/.scannerwork/**",
    "**/.stakpak/**",
    "**/.vercel/**",
    "**/.vscode/**",
    // Build output / dependency dirs that don't start with a dot.
    "node_modules",
    "dist",
    "out",
    "build",
    "storybook-static",
    // Source subtrees deliberately excluded from type-checking.
    "draft",
    "frontend/common/graphql/generated",
    "**/unRefactored_tests"
  ]
}
