{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mui-mcp": {
      "type": "local",
      "command": ["bun", "x", "-y", "@mui/mcp@latest"],
      "enabled": true
    },
    "next-devtools": {
      "command": ["bun", "x", "-y", "next-devtools-mcp@latest"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["bun", "x", "-y", "@playwright/mcp@0.0.38"]
    }
  }
}
