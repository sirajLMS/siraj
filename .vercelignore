# Vercel Ignore File
# Prevents uploading files that are not needed for building/running the app on Vercel.
# Scope for the deployable graph: next.config.ts -> typescript.tsconfigPath -> tsconfig.build.json.
# Next only bundles modules reachable from `app/**` + `instrumentation.ts` + `proxy.ts`;
# everything below is repo-only (tests, stories, scripts, docs, agent tooling) — it is
# type-checked by CI (`bun tsgo` over the full tsconfig.json), never by `next build`.

# local config & caches
.vercel
.next
.next-test
.eslintcache
.quality-gate-state.json
.scannerwork/
tsconfig.tsbuildinfo

# editor / IDE files
.vscode/
.idea/
.cursor/
.continue/
.claude/
.gemini/
.agent-sandbox/
.opencode/
.codex
opencode.json

# misc agent/CLI workspaces — repo-only, never needed at build or runtime
.agents/
.crush/
.devcontainer/
.kilo/
.junie/
.openhands/
.impeccable/
.codescene/
.quality-gate-lock/
.container/
.browser-auth/
.next-dev/
.next-test-dev/
.next-test-prod/
.playwright-mcp/
--help/

# CI/quality tooling configs — never needed by `next build` or runtime
cspell.config.yaml
.dependency-cruiser.js
apollo.config.json
graphql.config.yml
docker-compose*.yml
.tmp/
.trae/

# development logs
*.log
logs/
eslint-results.json
debug-eslint.js
debug-storybook.log

# storage & local uploads
/storage/
/storage

# tests, stories, storybook — type-checked by CI, never by `next build`
test/
frontend/stories/
.storybook/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/*.stories.ts
**/*.stories.tsx
**/*.fixtures.ts
**/*.fixtures.tsx

# scripts — keep only the exact build entrypoints (build wrapper + prebuild generators);
# everything else is CI/dev tooling. (Negations must follow per-directory globs — a
# blanket `scripts/**` would exclude the parent dirs and make re-inclusion impossible.)
scripts/*.ts
scripts/cmd/
scripts/dbActions/
scripts/eslint-rules/
scripts/health/
scripts/lint_helper/
scripts/ps1/
scripts/__pycache__/
scripts/unused/
scripts/ps/
!scripts/locale-snapshots.ts
scripts/lib/*
!scripts/lib/run-locked-cmd.ts
!scripts/lib/process-lock.ts
scripts/build/*
!scripts/build/generate-vercel-config.ts

# drizzle SQL migrations — applied via CLI (bun db), never read by the serverless runtime
backend/drizzle/
backend/drizzle-sqlite/

# quality/scan tooling state (knip, oxlint, jscpd, codescene, sonar)
.oxlint/
.unused/
.jscpd.json
sonar-project.properties

# docs / shell helpers (not needed for deployment)
docs/
*.md
*.ps1
*.sh
.github/

# misc agent/dev workspaces
scratch/
coverage/
ai/

# temp & backups
.env.bak
.env.example
.env.vercel
.env.test
.env.redis

# ai
.ai
.gitwandrc
*.txt
.playwright-cli
.agent-canvas
